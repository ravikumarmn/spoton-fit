# SpotOn API settings. Copy to `.env` in the repository root:
#     cp .env.example .env
# `.env` is git-ignored. Real environment variables override values here.
# Every setting and its default is documented in src/spotonfit/config.py.

# --- Required for AI features (meal analysis, suggestions, coach, workouts) ---
# Create a key at https://aistudio.google.com/apikey
# For real user data use a key from a PAID (billing-enabled) Google Cloud project,
# so prompts and photos are not used to improve Google's products.
GOOGLE_API_KEY=
# GEMINI_API_KEY also works if you prefer that name (GOOGLE_API_KEY wins if both are set).

# --- Auth ---
# Any long random string. Unset in dev = random key per restart (everyone is logged out).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENVIRONMENT=dev                 # dev | test | prod  (prod refuses to start without JWT_SECRET)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Database ---
# Default: a local SQLite file. Postgres URLs (Neon/Supabase) are converted to asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./spotonfit.db
AUTO_MIGRATE=true               # dev: apply migrations on startup. prod: the deploy runs them.
SPOTON_TZ=Asia/Kolkata

# --- Models (all current, stable Gemini model IDs as of Nov 2026) ---
SPOTON_MODEL_PROVIDER=google_genai
SPOTON_VISION_MODEL=gemini-3.8-flash      # food photo/text -> foods, counts, nutrition per unit
SPOTON_COACH_MODEL=gemini-3.8-flash       # coach chat with tool calls
SPOTON_PARSER_MODEL=gemini-3.5-flash-lite # cheap tasks: workouts (MET), meal suggestions
# Reasoning depth. gemini-3.8-flash: low|medium|high (minimal is an ERROR).
# gemini-3.5-flash-lite: minimal|low|medium|high. Higher = slower, more thorough.
SPOTON_VISION_THINKING=low
SPOTON_COACH_THINKING=low
SPOTON_PARSER_THINKING=minimal
SPOTON_LLM_TIMEOUT_S=20
SPOTON_LLM_MAX_RETRIES=2

# --- Coach memory (conversation history, one thread per day) ---
# auto: Postgres DATABASE_URL -> stored in the same database; SQLite -> CHAT_DB_PATH file.
# memory: in-process only (lost on restart).
COACH_MEMORY=auto
CHAT_DB_PATH=./spotonfit_chat.db

# --- Safety routing (optional overrides; defaults in config.SafetyPolicy) ---
# Messages containing these phrases get a fixed reply instead of diet advice.
# SAFETY__RED_FLAG_TERMS=["chest pain","fainted","dizzy","shortness of breath"]
# SAFETY__SUPPORT_REPLY="..."

# --- CORS (JSON list of allowed browser origins) ---
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:3000"]

# --- Policies (optional overrides; defaults follow Technical PRD section 9) ---
# Use a double underscore for nested values. Examples:
# TARGETS__DEFICIT_FRACTION=0.20
# TARGETS__PROTEIN_G_PER_KG={"lose_fat": 1.7, "build_muscle": 2.0, "maintain": 1.6}
# TARGETS__FLOOR_KCAL={"male": 1500, "female": 1200}
# ENERGY__TDEE_WINDOW_DAYS=21
# ESTIMATES__MACRO_ENERGY_TOLERANCE=0.25
# ENERGY__TDEE_MAX_WEEKLY_CHANGE_KCAL=100
# REVIEWS__STALL_WEEKS=2
# REVIEWS__PROPOSAL_STEPS=1500
# REVIEWS__MAX_WEEKLY_LOSS_PCT=1.0
# WEEK_STARTS_ON=sunday            # sunday (review ready each Sunday) | monday
# LIMITS__AI_PER_DAY=100
# LIMITS__LOGIN_PER_MINUTE=5

# --- Observability (optional) ---
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spotonfit
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db   # needs: uv sync --group evals
