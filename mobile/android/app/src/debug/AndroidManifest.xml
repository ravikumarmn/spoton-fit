<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Development only: this file is merged into DEBUG builds, never release builds.
         It lets the app talk plain http:// to the SpotOn API on your computer over Wi-Fi.
         Release builds talk https:// only. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"/>
</manifest>
